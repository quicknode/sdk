{
  "name": "my-sdk",
  "version": "0.1.0",
  "description": "A Rust SDK with Node.js bindings",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "my-sdk",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --cargo-cwd ../crates/node",
    "build:debug": "napi build --platform --cargo-cwd ../crates/node",
    "test": "node test.js",
    "test:ts": "npx tsx example.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT"
}
