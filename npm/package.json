{
  "name": "@quicknode/sdk",
  "version": "3.1.1",
  "description": "Quicknode SDK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quicknode/sdk.git"
  },
  "homepage": "https://github.com/quicknode/sdk",
  "bugs": {
    "url": "https://github.com/quicknode/sdk/issues"
  },
  "main": "sdk.js",
  "types": "sdk.d.ts",
  "exports": {
    ".": {
      "import": "./sdk.mjs",
      "require": "./sdk.js",
      "types": "./sdk.d.ts"
    }
  },
  "browser": "./browser.js",
  "files": [
    "index.js",
    "index.d.ts",
    "sdk.js",
    "sdk.d.ts",
    "sdk.mjs",
    "errors.js",
    "browser.js",
    "README.md",
    "*.node"
  ],
  "napi": {
    "binaryName": "index",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "aarch64-apple-darwin"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --manifest-path ../crates/node/Cargo.toml --output-dir .",
    "build:debug": "napi build --platform --manifest-path ../crates/node/Cargo.toml --output-dir .",
    "test": "node test.js",
    "test:ts": "npx tsx example.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT"
}
